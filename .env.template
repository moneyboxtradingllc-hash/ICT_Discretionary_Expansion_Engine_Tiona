# Copy this file to `.env` and fill in the values for THIS machine.
# `.env` is gitignored — your account never leaves your computer, and a `git pull`
# will never overwrite it.
#
#   cp .env.template .env       (macOS/Linux)
#   Copy-Item .env.template .env   (PowerShell)

# ── WHICH VENUE ───────────────────────────────────────────────────────────────
# ninjatrader (default) or topstepx. This decides WHICH block below you fill in.
# Fill in one, not both: the lane takes its account identity from the configured
# venue, so the other block's variables are ignored entirely.
DETERMINISTIC_VENUE=topstepx

# LUNA-TOPSTEPX-ONLY (2026-08-31): the NinjaTrader block was removed
# with the venue. TopstepX is the only supported brokerage; there is
# no NT_ACCOUNT / NT_INSTRUMENT to set and the lane refuses any other
# DETERMINISTIC_VENUE value.
#
# ── TopstepX — only when DETERMINISTIC_VENUE=topstepx ─────────────────────────
# Leave the NinjaTrader block above BLANK on this venue. Do not put a placeholder
# in NT_ACCOUNT: the lane takes its identity from TOPSTEPX_ACCOUNT_NAME here, and
# an unused NT value is simply ignored — but a placeholder in the wrong field is
# the kind of thing that gets copied into the right one later.
# Topstep has no NinjaTrader bridge, so this is the whole transport: it supplies
# both execution AND market data. Leave blank if you use NinjaTrader.
#
# API access is a PAID add-on on Topstep (~$29/mo at time of writing). Generate
# the key in TopstepX -> Settings -> API -> Add API Key.
# Verify everything with:  python -m broker.topstepx_preflight
#
# TOPSTEPX_USERNAME    your TopstepX login name (not your email address)
# TOPSTEPX_ACCOUNT_NAME must match the account name EXACTLY as TopstepX shows it.
#                      Prop traders hold several accounts; there is no default and
#                      no "first active account" fallback, because picking one
#                      silently would trade the wrong account.
# TOPSTEPX_CONTRACT    e.g. "MNQ". If it matches more than one active expiry the
#                      preflight refuses and asks for the exact contract id.
# TOPSTEPX_ACCOUNT_ID  PREFERRED pin (TOPSTEPX-INTEGRATION, 2026-08-04). The
#                      numeric account id from /api/Account/search. An id cannot
#                      be made ambiguous by a rename, so the read-only preflight
#                      prefers it over the name. Set ONE of ID or NAME; setting
#                      neither is a hard refusal, never a default.
# TOPSTEPX_ACCOUNT_FINGERPRINT
#                      Optional. Paste the `account.fingerprint` value from a
#                      previous preflight evidence artifact and the next run
#                      fails closed if the pinned account identity CHANGED.
#                      Not a secret — it is a one-way digest, not the account.
TOPSTEPX_USERNAME=
TOPSTEPX_API_KEY=
TOPSTEPX_ACCOUNT_ID=
TOPSTEPX_ACCOUNT_NAME=
TOPSTEPX_ACCOUNT_FINGERPRINT=
TOPSTEPX_CONTRACT=MNQ

# TOPSTEPX_ACCOUNT_ROLE  What the pinned account is FOR. REPORTING AND POLICY
#                      ONLY — it can never select, replace or override the
#                      account pinned by ID + fingerprint.
#                      TRADING_COMBINE | FUNDED | PRACTICE | UNDECLARED
#                      The venue's `simulated` flag describes the ROUTING
#                      ENVIRONMENT, not the role: a Trading Combine is
#                      simulated too, and calling it "practice" once already
#                      produced a wrong report (2026-08-04).
TOPSTEPX_ACCOUNT_ROLE=TRADING_COMBINE

# Real-money accounts are refused unless this is deliberately set to true.
# The venue reports whether an account is simulated and the bot trusts that flag.
# Read the trailing-drawdown warning in the preflight before ever setting this.
TOPSTEPX_ALLOW_LIVE=false

# Your combine size. This drives the TRAILING DRAWDOWN cap, which is the limit
# that actually ends prop accounts — a "50K Combine" is really a $2,000 risk
# account, and percent-of-equity sizing reads the $50,000 instead. Unset, that
# protection does not run at all. 50K | 100K | 150K
TOPSTEP_ACCOUNT_SIZE=50K

# Orders are DISARMED unless this is true. The lane still scans, decides and
# records everything with it false — it simply never sends. Leave it off until a
# full session has run and the funnel output looks right.
TOPSTEPX_ARM_ORDERS=false

# ── Luna, the external Brain — REQUIRED for the brain-on lane ─────────────────
# WITHOUT THESE THE BOT RUNS WITHOUT LUNA AND SAYS NOTHING ABOUT IT.
# `AI_BRAIN_ENABLED` and `AI_BRAIN_LLM` both default to FALSE in code, so a
# `.env` that omits them yields the DETERMINISTIC core: it still scans, still
# prints, still stands down -- and never once asks Luna. That failure is silent,
# which is exactly why the switches are written here rather than left to a
# default.
AI_BRAIN_ENABLED=true
AI_BRAIN_LLM=true
# The ONE authorized production model. A session authorization binds this value,
# so a different model here does not quietly substitute -- it refuses.
AI_BRAIN_MODEL=gpt-5.6-luna
# JSON mode is enforced by the schema contract; `on` is the audited setting.
BRAIN_JSON_MODE=on
# The audited request ceiling. Raising it is an operator decision, not a default.
AI_BRAIN_TIMEOUT_SECONDS=45
# Descriptive memory retrieval — context only, never execution authority.
AI_RETRIEVAL_ENABLED=true

# Credits: platform.openai.com
OPENAI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# SCAN_SYMBOL must be set for the brain-on lane; it defaults to "QQQ" otherwise,
# and the thesis lifecycle uses the same default for its cross-instrument guard.
#
# IT IS THE INSTRUMENT, NOT THE CONTRACT. `assert_production_instrument` accepts
# exactly "MNQ" and REFUSES "MNQ SEP26" -- the NinjaTrader-style instrument
# string -- so a template carrying the contract-month form makes the production
# session refuse to arm with RETIRED_OR_FOREIGN_INSTRUMENT. The month lives in
# the resolved TopstepX contract (CON.F.US.MNQ.U26), which the session resolves
# fresh; it never belongs in this variable.
SCAN_SYMBOL=MNQ
