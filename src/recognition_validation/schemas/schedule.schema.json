{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ict-stage5/schedule/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "schedule/v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classification": {
          "enum": [
            "CONSTRUCTED",
            "REPOSITORY_RECORDED",
            "APPROVED_ARCHIVE",
            "FICTIONAL",
            "UNKNOWN"
          ]
        },
        "author_role": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "classification",
        "author_role",
        "source_refs",
        "notes"
      ]
    },
    "corpus_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "algorithm": {
      "enum": [
        "RECORDED_TICKS",
        "FIXED_MINUTE_GRID",
        "CONSTRUCTED_ADVERSARIAL"
      ]
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "cognition_policy": {
      "const": "PRODUCTION_SCAN_ONCE_WITH_PLAN_WAKE_SEMANTICS"
    },
    "ticks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          },
          "decision_time_utc": {
            "type": "string",
            "format": "date-time"
          },
          "kind": {
            "enum": [
              "SCAN",
              "QUOTE_WAKE",
              "PREWARM",
              "RELEASE"
            ]
          },
          "source_ref": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "session_id",
          "ordinal",
          "decision_time_utc",
          "kind",
          "source_ref"
        ]
      },
      "minItems": 0
    },
    "warmup_cognition": {
      "const": "NONE"
    },
    "seal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "sealed_at": {
              "type": "string",
              "format": "date-time"
            },
            "sealer_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "sha256",
            "sealed_at",
            "sealer_ref"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "provenance",
    "corpus_digest",
    "algorithm",
    "algorithm_version",
    "cognition_policy",
    "ticks",
    "warmup_cognition",
    "seal"
  ]
}
