# TOPSTEP-1 — Tiona's Topstep (practice) credentials TEMPLATE.
# Copy these lines into your real .env (which is git-ignored) and fill the blanks
# PRIVATELY. Never commit real values. Maurice's Alpaca settings are separate and
# untouched by these.

TOPSTEP_USERNAME=            # your TopstepX / ProjectX username
TOPSTEP_API_KEY=             # the API key you generate in TopstepX Settings > API
TOPSTEP_ACCOUNT_ID=          # your practice/150K account id (numeric)
TOPSTEP_ENV=practice         # keep "practice" — never "live"/"funded" for this bot
TOPSTEP_BASE_URL=https://api.topstepx.com/api
TOPSTEP_EXECUTION_ENABLED=false   # leave false: blocks all order placement until you opt in
