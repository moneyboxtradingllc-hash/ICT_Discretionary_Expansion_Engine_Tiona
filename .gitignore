# ── Secrets & environment ──────────────────────────────────────────────────────
.env
*.env
*.env.*

# ── Python bytecode ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Tool caches ────────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Generated runtime data — keep folder structure, ignore contents ────────────
logs/*
!logs/.gitkeep

data/live_snapshots/*
!data/live_snapshots/.gitkeep

data/intent_archive/*
!data/intent_archive/.gitkeep

data/paper_trades/*
!data/paper_trades/.gitkeep

data/activation_reports/*
!data/activation_reports/.gitkeep

# DEPLOY-1 — per-instance state is never committed (only templates are tracked)
data/instances/
data/global_memory/

snapshots/*
!snapshots/.gitkeep

reports/*
!reports/.gitkeep

# ── Backup checkpoints (never commit) ─────────────────────────────────────────
*_BACKUP*/
ICT_Discretionary_Expansion_Engine_BACKUP*/

# ── OS artifacts ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
