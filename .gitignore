# ── Secrets & environment ──────────────────────────────────────────────────────
.env
*.env
*.env.*
# ...but the TEMPLATE carries no secrets and must ship, or a second operator has
# no way to know which variables the bot requires.
!.env.template

# ── Python bytecode ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo

# ── Tool caches ────────────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ── Virtual environments ───────────────────────────────────────────────────────
.venv/
venv/
env/

# ── Generated runtime data — keep folder structure, ignore contents ────────────
logs/*
!logs/.gitkeep

data/live_snapshots/*
!data/live_snapshots/.gitkeep

data/intent_archive/*
!data/intent_archive/.gitkeep

data/paper_trades/*
!data/paper_trades/.gitkeep

data/activation_reports/*
!data/activation_reports/.gitkeep

# Adaptive memory vector store + legacy archive — runtime state, never committed
# (active store populated by ADAPTIVE-1A.5 scar collection; archive kept locally).
data/ai_retrieval/*
!data/ai_retrieval/.gitkeep

# AI Brain per-scan logs/records — per-instance runtime state, never committed.
data/ai_brain/*
!data/ai_brain/.gitkeep

# DEPLOY-1 — per-instance state is never committed (only templates are tracked)
data/instances/
data/global_memory/

# NinjaTrader bridge IPC journal — every envelope in both directions, so it grows
# without bound during a session. Measured 553 MB on 2026-07-28, which is well
# past GitHub's 100 MB hard limit: a single `git add -A` would wedge the repo for
# both remotes. Runtime evidence, never committed.
data/integration/ninjatrader/*.jsonl
data/integration/ninjatrader/*_result.json

# Per-session runtime state produced by the live lanes — shadow reads, ops
# incidents, performance tables, recommendations, governance ledger, HTF memory.
# All per-instance; committing them would make two machines fight over history.
data/ai_shadow/
data/ops/
data/performance/
data/performance_quarantine_*/
data/recommendations/
data/rule_governance/ledger/
data/htf_memory/

snapshots/*
!snapshots/.gitkeep

reports/*
!reports/.gitkeep

# ── Backup checkpoints (never commit) ─────────────────────────────────────────
*_BACKUP*/
ICT_Discretionary_Expansion_Engine_BACKUP*/

# ── OS artifacts ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# REPLAY-1 — candle archive + future replay run artifacts (market data, never committed)
data/replay/

# One-use smoke-order token — runtime credential, never commit
data/integration/ninjatrader/smoke_authorization.json

# Deterministic lane runtime state (session + stop flag + evidence stream)
data/integration/topstepx/deterministic/session_state.json
data/integration/topstepx/deterministic/STOP
data/integration/topstepx/deterministic/evidence/

# TOPSTEPX-DATA-PROVIDER — locally accumulated Topstep candle cache.
# Runtime data, not source: it grows one line per minute of market time
# and is rebuilt by simply running the provider.
data/market_data/

# DECON-3: retired QQQ/Alpaca evidence is local forensic history, not tracked
archive/legacy_alpaca_qqq/performance_QQQ/
archive/legacy_alpaca_qqq/htf_memory_QQQ.json

# Durable production session state — never committed (PRODUCTION-AUTHORIZATION-CLI)
data/integration/topstepx/session_auth_*.json
# Retired authorization records. Same policy, one directory deeper: the pattern
# above is anchored, so retiring a record by MOVING it was silently taking it
# out of scope. An authorization record is never committed, retired or not.
data/integration/topstepx/retired_authorizations/session_auth_*.json
# Flight-recorder submission stream — same class as trade_mission_*.json below:
# raw durable session state, not an evidence report. The postmortems that cite
# it are committed; the runtime stream it summarises stays local.
data/integration/topstepx/submissions_*.jsonl
data/integration/topstepx/trade_mission_*.json
data/integration/topstepx/mission_voids_*.json
data/integration/topstepx/active_execution_context.json
data/integration/topstepx/slippage_observations.jsonl
data/integration/topstepx/session_*.json

# Session-replay archives: raw runtime + account-derived evidence, never committed
data/replay_sessions/

# Terra migration evaluation output (counterfactual, local only)
data/replay_sessions/_terra_eval/

# ── TIONA SANITIZED SYNC (2026-08-31) ────────────────────────────────────────
# Restored from this repository's own history: Topstep durable account state
# (trailing-drawdown high-water mark + prior-day close, written by
# risk/topstep_limits.py). It is per-account and per-machine: committing it
# would push one operator's balance history to the shared remote and hand it to
# the other on their next pull.
data/topstep/

# BLANKET RUNTIME EXCLUSION. The upstream repository tracked 88 files under
# data/ -- execution smoke results, session records, missions, preflight
# artifacts, readiness reports -- several of which embedded a live brokerage
# account id and fingerprint. None of that is application source, and evidence
# from one operator's account has no meaning in another's repository. The code
# recreates whatever it needs at runtime.
#
# Negations below re-admit only structural placeholders, never content.
data/
!data/.gitkeep
!data/**/.gitkeep
